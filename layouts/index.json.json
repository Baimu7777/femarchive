{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $pages = where $pages "Params.hidden" "ne" true -}}
[
{{- range $index, $page := $pages.ByDate.Reverse }}
  {{- if gt $index 0 }},{{ end }}
  {
    "title": {{ $page.Title | jsonify }},
    "description": {{ $page.Description | default "" | jsonify }},
    "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "permalink": {{ $page.RelPermalink | jsonify }},
    "author": {{ $page.Params.author | default "编辑部" | jsonify }},
    "categories": {{ $page.Params.categories | default (slice) | jsonify }},
    "tags": {{ $page.Params.tags | default (slice) | jsonify }},
    "keywords": {{ $page.Params.keywords | default (slice) | jsonify }},
    "content": {{ $page.Plain | jsonify }}
  }
{{- end }}
]
